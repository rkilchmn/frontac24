# ---------------------------------------------------------------------------
# Copy to .env and adjust:  cp .env.example .env
# .env is gitignored - it holds the database credentials.
# ---------------------------------------------------------------------------

# port the web UI is published on (http://localhost:8080)
HTTP_PORT=8090

# --- network --------------------------------------------------------------
# The web UI is bound to 127.0.0.1 by default (not reachable from the LAN).
# Set HTTP_BIND=0.0.0.0 to expose it on all interfaces.
HTTP_BIND=127.0.0.1

# --- database -------------------------------------------------------------
DB_NAME=frontacc
DB_USER=frontacc
DB_PASSWORD=change_me
DB_ROOT_PASSWORD=change_me_too

# --- company / database mapping -------------------------------------------
# Format: <index>|<display name>|<table prefix>, entries separated by ";"
# The index is the company number used by FrontAccounting (it also selects
# the core/company/<index> working directory), the table prefix is the one
# used in the database. Keep this in sync with the production config.
#
# Only the company you have a dump for should be listed - a company without
# tables in the database makes the login screen fail.
FA_COMPANIES="0|GBC|0_;1|Demo Company|5_;2|FTSS|4_;3|Financial Technology Consulting Pty Ltd|6_"
# index of the company that is preselected on the login screen
FA_DEF_COY=2
# FA's internal table prefix counter (admin/create_coy.php)
FA_TB_PREF_COUNTER=7

# --- runtime --------------------------------------------------------------
# server timezone - FA falls back to Europe/Berlin when php has none set
FA_TIMEZONE=Europe/Berlin
# 1 = session cookie is flagged "secure" (requires https), 0 = plain http
FA_SECURE_ONLY=0

# --- php ------------------------------------------------------------------
# PHP version of the php-fpm image. 8.5.12 matches the production server.
# Use a minor version (8.5) to always get the latest patch release.
PHP_VERSION=8.5.12

# --- debugging (Xdebug, development stack only) ----------------------------
# The variables are only read by the dev compose file (docker-compose.dev.yml).
# VS Code listens on XDEBUG_CLIENT_PORT, Xdebug in the container dials it.
XDEBUG_CLIENT_HOST=host.docker.internal
XDEBUG_CLIENT_PORT=9003
# debug = step debugging, develop = nicer error messages (FA calls
# xdebug_call_file(), which only exists in develop mode), both combined
XDEBUG_MODE=develop,debug
# yes = every request opens a debug session,
# trigger = only requests carrying the XDEBUG_TRIGGER cookie/query parameter
XDEBUG_START_WITH_REQUEST=yes

# --- development ----------------------------------------------------------
# numeric uid/gid of the host user, so files written by PHP stay yours.
# `make dev-env` fills these in automatically.
FA_POOL_USER=1999
FA_POOL_GROUP=1999
